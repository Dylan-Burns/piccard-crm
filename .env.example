# Copy to .env.local. For local development run `supabase start` and use the
# API URL, publishable key and secret key it prints (`supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Added in later phases (all optional until then)
CRON_SECRET=
LEAD_WEBHOOK_SECRET=
GOOGLE_ADS_WEBHOOK_KEY=
RESEND_API_KEY=
EMAIL_FROM=
INTEGRATION_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
